# {{ ansible_managed }}
# Squid configuration managed by Ansible

http_port {{ squid_http_port }}
visible_hostname {{ squid_visible_hostname }}
cache_mem {{ squid_cache_mem }}
maximum_object_size {{ squid_maximum_object_size }}
cache_dir ufs {{ squid_cache_dir }} {{ squid_cache_size }} 16 256

acl localnet src {{ squid_allowed_networks | join(' ') }}
http_access allow localnet
http_access allow localhost
http_access deny all
